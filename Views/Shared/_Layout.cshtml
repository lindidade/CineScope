<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineScope</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/cinescope.css" asp-append-version="true" />
</head>
<body>

    <nav class="cs-navbar">
        <div class="cs-navbar-inner">

            <a class="cs-logo" asp-controller="Home" asp-action="Index">
                CINE<span>SCOPE</span>
            </a>

            <ul class="cs-nav-links">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Movies" asp-action="Index">Movies</a></li>
            </ul>

            <form asp-controller="Movies" asp-action="Index" method="get" class="cs-search-form">
                <i class="bi bi-search"></i>
                <input type="search" name="search" placeholder="Search movies…"
                       value="@ViewData["CurrentSearch"]" />
            </form>
            <div style="display: flex; align-items: center;">
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item" style="list-style: none; display: inline-block; margin-right: 1rem; align-self: center;">
                        <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    </li>
                }

                @if (User.Identity!.IsAuthenticated)
                {
                    <span style="color: var(--cs-text-muted); font-size:14px; margin-right:1rem;">
                        👤 @User.Identity.Name
                    </span>
                    <form asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Movies")"
                          method="post" style="display:inline;">
                        <button type="submit" class="cs-btn-red" style="border:none; cursor:pointer;">
                            Logout
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="nav-link text-white" style="display: inline-block; margin-right: 1rem; align-self: center; text-decoration: none; font-weight: 500;">
                        Register
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="cs-btn-red">
                        Login
                    </a>
                }
            </div>
        </div>
    </nav>

    <main class="cs-main">
        @RenderBody()
    </main>

    <footer class="cs-footer">
        <div class="container">
            &copy; 2026 CineScope
        </div>
    </footer>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
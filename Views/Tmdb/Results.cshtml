@model List<CineScope.Models.Movie>
@{
    ViewData["Title"] = "Sökresultat";
    string query = ViewData["Query"] as string ?? "";
}

<div class="cs-details-page">
    <h1 class="cs-page-title">Resultat för "@query"</h1>
    <p style="color:var(--cs-text-muted); margin-bottom:2rem;">
        Klicka på importera för att lägga till en film i din databas.
    </p>

    <div class="cs-movie-grid">
        @foreach (var movie in Model)
        {
            <div class="cs-movie-card">
                <div class="cs-poster">
                    @if (!string.IsNullOrEmpty(movie.PosterUrl))
                    {
                        <img src="@movie.PosterUrl" alt="@movie.Title" />
                    }
                    else
                    {
                        <div style="width:100%;height:100%;background:var(--cs-dark);
                            display:flex;align-items:center;justify-content:center;
                            color:var(--cs-text-muted);">
                            Ingen poster
                        </div>
                    }
                    <div class="cs-rating-badge">★ @movie.Rating</div>
                </div>

                <div class="cs-card-body">
                    <h3 class="cs-card-title">@movie.Title</h3>
                    <div class="cs-card-meta">
                        <span>@movie.ReleaseYear</span>
                    </div>
                    <p class="cs-card-desc">@movie.Description</p>

                    
                    <form asp-controller="Tmdb" asp-action="Import" method="post">
                        <input type="hidden" name="title" value="@movie.Title" />
                        <input type="hidden" name="description" value="@movie.Description" />
                        <input type="hidden" name="releaseYear" value="@movie.ReleaseYear" />
                        <input type="hidden" name="rating" value="@movie.Rating" />
                        <input type="hidden" name="posterUrl" value="@movie.PosterUrl" />
                        <input type="text" name="genre" placeholder="Ange genre..."
                               class="cs-input" style="margin-bottom:0.5rem;" />
                        <button type="submit" class="cs-btn-red">
                            + Importera
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div style="margin-top:2rem;">
        <a asp-controller="Tmdb" asp-action="Search" class="cs-back-link">
            ← Sök igen
        </a>
    </div>
</div>
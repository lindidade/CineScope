@model CineScope.Models.Movie
@{
    ViewData["Title"] = Model.Title;
}

<div class="cs-details-page">

    
    <div class="cs-details-hero">
        <div class="cs-details-poster">
            <img src="@Model.PosterUrl" alt="@Model.Title"
                 onerror="this.src='/img/no-poster.jpg'" />
        </div>
        <div class="cs-details-info">
            <h1 class="cs-details-title">@Model.Title</h1>
            <div class="cs-details-meta">
                <span class="cs-genre">@Model.Genre</span>
                <span>@Model.ReleaseYear</span>
                <span>@Model.Duration min</span>
                <span style="color:var(--cs-yellow);">★ @Model.Rating</span>
            </div>
            <p class="cs-details-desc">@Model.Description</p>

            @if (User.IsInRole("Admin"))
            {
                <div style="display:flex; gap:0.75rem; margin-top:1rem;">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="cs-btn-red">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="cs-btn-outline">Delete</a>
                </div>
            }

            <a asp-action="Index" class="cs-back-link">← Back to movies</a>
        </div>
    </div>

    
    <div class="cs-reviews-section">
        <h2 class="cs-reviews-title">Reviews (@Model.Reviews.Count)</h2>

        
        @if (User.Identity!.IsAuthenticated)
        {
            <div class="cs-review-form">
                <h3>Write a review</h3>
                <form asp-controller="Reviews" asp-action="Create" method="post">
                    <input type="hidden" name="movieId" value="@Model.Id" />

                    <div class="cs-form-group">
                        <label>Rating (1-10)</label>
                        <input type="number" name="rating" min="1" max="10"
                               class="cs-input" required />
                    </div>

                    <div class="cs-form-group">
                        <label>Comment</label>
                        <textarea name="comment" rows="3"
                                  class="cs-input" placeholder="What did you think of the movie?"
                                  required></textarea>
                    </div>

                    <button type="submit" class="cs-btn-red">Send review</button>
                </form>
            </div>
        }
        else
        {
            <p style="color:var(--cs-text-muted);">
                <a asp-area="Identity" asp-page="/Account/Login" style="color:var(--cs-red);">Login</a>
                to write a review.
            </p>
        }

       
        @if (Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
            {
                <div class="cs-review-card">
                    <div class="cs-review-header">
                        <span class="cs-review-user">👤 @review.User?.Email</span>
                        <span class="cs-review-rating">★ @review.Rating/10</span>
                        <span class="cs-review-date">@review.CreatedAt.ToString("yyyy-MM-dd")</span>
                    </div>
                    <p class="cs-review-comment">@review.Comment</p>

                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-controller="Reviews" asp-action="Delete" method="post">
                            <input type="hidden" name="id" value="@review.Id" />
                            <input type="hidden" name="movieId" value="@Model.Id" />
                            <button type="submit" class="cs-btn-outline"
                                    style="font-size:12px; padding:0.2rem 0.6rem;">
                                Delete
                            </button>
                        </form>
                    }
                </div>
            }
        }
        else
        {
            <p style="color:var(--cs-text-muted);">Be the first to review this movie!</p>
        }
    </div>
</div>
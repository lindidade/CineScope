@model IEnumerable<CineScope.Models.Movie>

<div class="bg-gray-900 min-h-screen p-8">
    <h1 class="text-4xl font-bold text-white mb-8">🎬 CineScope</h1>
    
    <form method="get" asp-action="Index" class="mb-8">
        <div class="flex gap-2">
            <input type="text" name="searchString"
                   class="bg-gray-800 text-white rounded-lg px-4 py-2 w-96 border border-gray-600"
                   placeholder="Sök efter film..." />
            <button type="submit"
                    class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700">
                Sök
            </button>
        </div>
    </form>

    <a asp-action="Create"
           class="bg-red-600 text-white px-4 py-2 rounded-lg hover:bg-red-700 mb-8 inline-block">
        + Lägg till film
    </a>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 mt-6">
        @foreach (var item in Model)
        {
            <div class="bg-gray-800 rounded-lg overflow-hidden hover:scale-105 transition-transform duration-300">
                <img src="@item.PosterUrl" alt="@item.Title"
                     class="w-full h-64 object-cover"
                     onerror="this.src='https://via.placeholder.com/300x400?text=No+Image'" />
                <div class="p-4">
                    <h2 class="text-white font-bold text-lg">@item.Title</h2>
                    <p class="text-gray-400 text-sm">@item.Genre • @item.ReleaseYear</p>
                    <p class="text-yellow-400 text-sm">⭐ @item.Rating</p>
                    <div class="flex gap-2 mt-3">
                        <a asp-action="Edit" asp-route-id="@item.Id"
                           class="text-blue-400 hover:text-blue-300 text-sm">Redigera</a>
                        <a asp-action="Details" asp-route-id="@item.Id"
                           class="text-green-400 hover:text-green-300 text-sm">Detaljer</a>
                        <a asp-action="Delete" asp-route-id="@item.Id"
                           class="text-red-400 hover:text-red-300 text-sm">Radera</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
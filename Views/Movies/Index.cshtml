@model IEnumerable<CineScope.Models.Movie>
@{
    ViewData["Title"] = "Movies";
    var genres = Model.Select(m => m.Genre).Distinct().OrderBy(g => g).ToList();
    string currentGenre = ViewData["CurrentGenre"] as string ?? "";
    string currentSearch = ViewData["CurrentSearch"] as string ?? "";
}

<div class="cs-page-header">
    <h1>Movies</h1>
    @if (User.IsInRole("Admin"))
    {
        <div style="display: flex; gap: 1rem;">
            <a asp-controller="Tmdb" asp-action="Search" class="cs-btn-outline">
                + Search External (TMDB)
            </a>
            <a asp-action="Create" class="cs-btn-red">
                + Add Movie
            </a>
        </div>
    }
</div>


<div class="cs-filter-bar">
    <a href="@Url.Action("Index", "Movies")"
           class="cs-filter-btn @(string.IsNullOrEmpty(currentGenre) ? "active" : "")">
        All
    </a>
    @foreach (var genre in genres)
    {
        <a href="@Url.Action("Index", "Movies", new { genre = genre })"
               class="cs-filter-btn @(currentGenre == genre ? "active" : "")">
            @genre
        </a>
    }
</div>

<div class="cs-movie-grid">
    @foreach (var movie in Model)
    {
        <div class="cs-movie-card">
            <div class="cs-poster">
                <img src="@movie.PosterUrl" alt="@movie.Title"
                     onerror="this.src='/img/no-poster.jpg'" />
                <div class="cs-rating-badge">
                    ★ @movie.Rating
                </div>
            </div>
            <div class="cs-card-body">
                <h3 class="cs-card-title">@movie.Title</h3>
                <div class="cs-card-meta">
                    <span class="cs-genre">@movie.Genre</span>
                    <span>@movie.ReleaseYear</span>
                    <span>@movie.Duration min</span>
                </div>
                <p class="cs-card-desc">@movie.Description</p>
                <div class="cs-card-actions">
                    <a asp-action="Details" asp-route-id="@movie.Id" class="cs-btn-red">Details</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@movie.Id" class="cs-btn-outline">Edit</a>
                        <a asp-action="Delete" asp-route-id="@movie.Id" class="cs-btn-outline">Delete</a>
                    }
                </div>
            </div>
        </div>
    }
</div>
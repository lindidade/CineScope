
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineScope</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Din CSS (alltid sist!) -->
    <link rel="stylesheet" href="~/css/cinescope.css" asp-append-version="true" />
</head>
<body>

    <!-- NAVBAR -->
    <nav class="cs-navbar">
        <div class="cs-navbar-inner">

            <!-- Logo -->
            <a class="cs-logo" asp-controller="Home" asp-action="Index">
                CINE<span>SCOPE</span>
            </a>

            <!-- Länkar -->
            <ul class="cs-nav-links">
                <li><a asp-controller="Home" asp-action="Index">Hem</a></li>
                <li><a asp-controller="Movies" asp-action="Index">Filmer</a></li>
            </ul>

            <!-- Sökfält -->
            <form asp-controller="Movies" asp-action="Index" method="get" class="cs-search-form">
                <i class="bi bi-search"></i>
                <input type="search" name="search" placeholder="Sök film…"
                       value="@ViewData["CurrentSearch"]" />
            </form>

        </div>
    </nav>

    <!-- SIDINNEHÅLL -->
    <main class="cs-main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="cs-footer">
        <div class="container">
            &copy; 2026 CineScope
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>